Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Lets", " ", "try", " ", "this", " ", 
     RowBox[{"test", " ", "--"}], " ", "integration", " ", "of", " ", "a", 
     " ", "Gaussian", " ", "using", " ", "Newton"}], "-", 
    RowBox[{"Cotes", " ", "rules"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", "x_", "]"}], "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"Sin", "[", "x", "]"}], "2"], "+", 
        SuperscriptBox["x", "2"], "+", 
        RowBox[{"2", 
         SuperscriptBox["x", "4"]}], "+", 
        FractionBox["1", "10"]}], ")"}], 
      RowBox[{"Exp", "[", 
       RowBox[{"-", 
        SuperscriptBox["x", "2"]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xmax", "=", "7"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xmin", "=", 
     RowBox[{"-", "xmax"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"exact", "=", 
     RowBox[{"Re", "[", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"f", "[", "x", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "xmin", ",", "xmax"}], "}"}]}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalDelta]", " ", "=", " ", 
     FractionBox[
      RowBox[{"xmax", "-", "xmin"}], 
      RowBox[{"nOfPoints", "-", "1"}]]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rectangularLeft", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"nOfPoints", ",", 
         RowBox[{"\[CapitalDelta]", " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"f", "[", 
             RowBox[{"xmin", "+", 
              RowBox[{"\[CapitalDelta]", " ", 
               RowBox[{"(", 
                RowBox[{"i", "-", "1"}], ")"}]}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", 
              RowBox[{"nOfPoints", "-", "1"}]}], "}"}]}], "]"}]}]}], "}"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"nOfPoints", ",", "10", ",", "100", ",", "2"}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rectangularRight", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"nOfPoints", ",", 
         RowBox[{"\[CapitalDelta]", " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"f", "[", 
             RowBox[{"xmin", "+", 
              RowBox[{"\[CapitalDelta]", " ", 
               RowBox[{"(", 
                RowBox[{"i", "-", "1"}], ")"}]}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "2", ",", "nOfPoints"}], "}"}]}], "]"}]}]}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"nOfPoints", ",", "10", ",", "100", ",", "2"}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"trapezoidal", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"nOfPoints", ",", 
         RowBox[{
          RowBox[{
           FractionBox[
            RowBox[{
             RowBox[{"f", "[", "xmin", "]"}], "+", 
             RowBox[{"f", "[", "xmax", "]"}]}], "2"], "\[CapitalDelta]"}], 
          "+", 
          RowBox[{"\[CapitalDelta]", " ", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{"f", "[", 
              RowBox[{"xmin", "+", 
               RowBox[{"\[CapitalDelta]", " ", 
                RowBox[{"(", 
                 RowBox[{"i", "-", "1"}], ")"}]}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "2", ",", 
               RowBox[{"nOfPoints", "-", "1"}]}], "}"}]}], "]"}]}]}]}], "}"}],
        ",", 
       RowBox[{"{", 
        RowBox[{"nOfPoints", ",", "10", ",", "100", ",", "2"}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"simpsonsOneThird", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"nOfPoints", ",", 
         RowBox[{
          FractionBox["\[CapitalDelta]", "3"], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"f", "[", "xmin", "]"}], "+", 
            RowBox[{"f", "[", "xmax", "]"}], "+", " ", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"EvenQ", "[", 
                  RowBox[{"i", "-", "1"}], "]"}], ",", "2", ",", "4"}], "]"}], 
               RowBox[{"f", "[", 
                RowBox[{"xmin", "+", 
                 RowBox[{"\[CapitalDelta]", " ", 
                  RowBox[{"(", 
                   RowBox[{"i", "-", "1"}], ")"}]}]}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "2", ",", 
                RowBox[{"nOfPoints", "-", "1"}]}], "}"}]}], "]"}]}], 
           ")"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"nOfPoints", ",", "11", ",", "100", ",", "2"}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"simpsonsThreeThirds", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"nOfPoints", ",", 
         RowBox[{
          FractionBox[
           RowBox[{"3", "\[CapitalDelta]"}], "8"], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"f", "[", "xmin", "]"}], "+", 
            RowBox[{"f", "[", "xmax", "]"}], "+", " ", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Mod", "[", 
                   RowBox[{
                    RowBox[{"i", "-", "1"}], ",", "3"}], "]"}], "\[Equal]", 
                  "0"}], ",", "2", ",", "3"}], "]"}], 
               RowBox[{"f", "[", 
                RowBox[{"xmin", "+", 
                 RowBox[{"\[CapitalDelta]", " ", 
                  RowBox[{"(", 
                   RowBox[{"i", "-", "1"}], ")"}]}]}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "2", ",", 
                RowBox[{"nOfPoints", "-", "1"}]}], "}"}]}], "]"}]}], 
           ")"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"nOfPoints", ",", "10", ",", "100", ",", "3"}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"N", "[", 
     RowBox[{"N", "[", 
      RowBox[{"rectangularLeft", ",", "20"}], "]"}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"N", "[", 
     RowBox[{"N", "[", 
      RowBox[{"rectangularRight", ",", "20"}], "]"}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"N", "[", 
     RowBox[{"N", "[", 
      RowBox[{"trapezoidal", ",", "20"}], "]"}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"N", "[", 
     RowBox[{"N", "[", 
      RowBox[{"simpsonsOneThird", ",", "20"}], "]"}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Clear", "[", 
    RowBox[{
    "nOfPoints", ",", "array", ",", "\[CapitalDelta]", ",", "xmin", ",", 
     "xmax"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rule", "=", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x_", ",", "y_"}], "}"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"Abs", "[", 
         RowBox[{"y", "-", "exact"}], "]"}]}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rectangularLeftErrors", "=", 
     RowBox[{"N", "[", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"rectangularLeft", "/.", "rule"}], ",", "20"}], "]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rectangularRightErrors", "=", 
     RowBox[{"N", "[", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"rectangularRight", "/.", "rule"}], ",", "20"}], "]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"trapezoidalErrors", "=", 
     RowBox[{"N", "[", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"trapezoidal", "/.", "rule"}], ",", "20"}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"simpsonsOneThirdErrors", "=", 
     RowBox[{"N", "[", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"simpsonsOneThird", "/.", "rule"}], ",", "20"}], "]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"simpsonsThreeThirdsErrors", "=", 
     RowBox[{"N", "[", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"simpsonsThreeThirds", "/.", "rule"}], ",", "20"}], "]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Fit", "[", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"Take", "[", 
        RowBox[{"rectangularLeftErrors", ",", 
         RowBox[{"-", "20"}]}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "x"}], "}"}], ",", "x"}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Fit", "[", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"Take", "[", 
        RowBox[{"rectangularRightErrors", ",", 
         RowBox[{"-", "20"}]}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "x"}], "}"}], ",", "x"}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Fit", "[", 
    RowBox[{
     RowBox[{"Log", "[", 
      RowBox[{"Take", "[", 
       RowBox[{"trapezoidalErrors", ",", 
        RowBox[{"-", "20"}]}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "x"}], "}"}], ",", "x"}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Fit", "[", 
    RowBox[{
     RowBox[{"Log", "[", 
      RowBox[{"Take", "[", 
       RowBox[{"simpsonsOneThirdErrors", ",", 
        RowBox[{"-", "20"}]}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "x"}], "}"}], ",", "x"}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Fit", "[", 
