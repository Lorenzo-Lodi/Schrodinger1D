Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Long", "-", 
    RowBox[{"range", " ", "behaviour", " ", "of", " ", "Qtilde"}]}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"From", " ", 
    RowBox[{"eq", ".", " ", "31"}], " ", "and", " ", "32", " ", "in", " ", 
    "the", " ", "paper"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"r", "[", "y_", "]"}], "=", 
     RowBox[{"rbar", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox[
         RowBox[{"1", "+", "y"}], 
         RowBox[{"1", "-", "y"}]], ")"}], 
       RowBox[{"1", "/", "\[Alpha]"}]]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"g", "[", "y_", "]"}], "=", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"r", "[", "y", "]"}], ",", "y"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"F", "[", "y_", "]"}], "=", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{"g", "''"}], "[", "y", "]"}], 
        RowBox[{"2", 
         RowBox[{"g", "[", "y", "]"}]}]], "-", 
       RowBox[{
        FractionBox["3", "4"], 
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox[
           RowBox[{
            RowBox[{"g", "'"}], "[", "y", "]"}], 
           RowBox[{"g", "[", "y", "]"}]], ")"}], "2"]}]}], "]"}]}], 
    ";"}]}]}]], "Input",
